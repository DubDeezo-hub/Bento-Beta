    <!-- help pages for problems -->
    <string name="help_button">Hva kan jeg gjøre?</string>
    <string name="help_what">Hva skjedde</string>
    <string name="help_try">Hva du kan prøve</string>
    <string name="help_details">Detaljer</string>
    <string name="help_copy">Kopier detaljer</string>
    <string name="help_copied">Kopiert</string>
    <string name="help_unreachable_title">Får ikke kontakt med konsollen</string>
    <string name="help_unreachable_what">Ingenting svarer på konsollens adresse.</string>
    <string name="help_unreachable_try">• Sjekk IP-adressen på %1$s (Innstillinger &gt; Nettverk &gt; Tilkoblingsstatus). Den kan endres etter en omstart.\n• Vekk konsollen helt. Hvilemodus slår ofte av nettverket.\n• Bruk det samme Wi-Fi-nettverket på begge. Gjestenettverk og VPN blokkerer det.</string>
    <string name="help_port_title">Den tjenesten kjører ikke</string>
    <string name="help_port_what">Konsollen svarte, men ingenting lytter på den porten.</string>
    <string name="help_port_try">• Start etaHEN på konsollen. Den gir deg Installer (12800), Loader (9021) og FTP (1337).\n• En separat FTP-payload bruker vanligvis 2121. Skriv inn samme port her.\n• På konsollkortet viser lyset som er av hva som mangler.</string>
    <string name="help_port_try_ps4">• Start GoldHEN på konsollen. Den gir deg Loader (9090) og FTP (2121).\n• For å installere pakker må også Remote Package Installer fra flatz kjøre på konsollen (12800).\n• På konsollkortet viser lyset som er av hva som mangler.</string>
    <string name="help_login_title">FTP-pålogging avvist</string>
    <string name="help_login_what">Konsollens FTP-server avviste brukernavnet eller passordet.</string>
    <string name="help_login_try">• %2$s godtar brukernavnet anonymous med hvilket som helst passord.\n• Hvis du har satt en pålogging på konsollen, skriver du den inn under Last opp.\n• Passordet lagres ikke. Skriv det inn på nytt etter at appen er startet på nytt.</string>
    <string name="help_dropped_title">Tilkoblingen ble brutt</string>
    <string name="help_dropped_what">Forbindelsen til konsollen ble brutt, eller dataene sluttet å bevege seg. Appen prøver på nytt og fortsetter der den stoppet.</string>
    <string name="help_dropped_try">• Hold telefonen nær ruteren og konsollen våken.\n• Sett andre store nedlastinger på nettverket på pause.\n• Hvis det fortsetter å mislykkes, vent litt og trykk Prøv igjen.</string>
    <string name="help_refused_title">Installer tok ikke imot lenken</string>
    <string name="help_refused_what">Konsollen kan nås, men Installer på den avviste denne lenken.</string>
    <string name="help_refused_try">• Lenken må peke rett til pakkefilen og åpnes uten pålogging.\n• Konsollen må kunne nå den. Lenker fra denne telefonen fungerer bare på samme Wi-Fi.\n• Sjekk at Installer kjører og at konsollen har ledig plass.</string>
    <string name="help_storage_title">Konsollen sluttet å lagre</string>
    <string name="help_storage_what">Konsollen beholdt mindre enn det som ble sendt. Stasjonen er vanligvis full eller skrivebeskyttet.</string>
    <string name="help_storage_try">• Frigjør plass på konsollen.\n• Velg en annen mappe, for eksempel på en USB-stasjon.\n• Trykk deretter Prøv igjen.</string>
    <string name="help_denied_title">Mappen eller filen ble avvist</string>
    <string name="help_denied_what">FTP-serveren kan ikke åpne, skrive til eller endre den her.</string>
    <string name="help_denied_try">• Sjekk at mappen finnes. Det skilles mellom store og små bokstaver i navn.\n• Systemmapper er skrivebeskyttet. Bruk /data eller en USB-stasjon.\n• En fil som brukes av et spill som kjører, kan være låst. Lukk spillet.</string>
    <string name="help_phone_title">Telefonen kan ikke bruke filen</string>
    <string name="help_phone_what">Filen er borte eller flyttet, appen mistet tilgangen til den, eller telefonen har ikke mer plass.</string>
    <string name="help_phone_try">• Velg filen på nytt.\n• Frigjør lagringsplass på telefonen.\n• For en fil i en skyapp må du lagre den på telefonen først.</string>
    <string name="help_link_title">Nedlastingslenken mislyktes</string>
    <string name="help_link_what">Nettstedet ga ikke fra seg filen. Lenken kan ha utløpt, kreve pålogging, eller nettstedet kan være opptatt.</string>
    <string name="help_link_try">• Start nedlastingen på nytt fra Web-fanen. Da beholdes påloggingen din.\n• Lenker fra fildelingssider utløper ofte etter noen minutter.\n• Hvis nettstedet rapporterte en feil i 500-serien, prøv igjen senere.</string>

