<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Every phone setting. Bento is dark only (blood red and black, Theme.kt): the status bar takes the red glow's dark edge, the
        navigation bar and the first frame the black page, so nothing flashes before the screen is drawn.
    -->
    <style name="Theme.PSSender" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">#050304</item>
        <item name="android:statusBarColor">#1A0206</item>
        <item name="android:navigationBarColor">#050304</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
