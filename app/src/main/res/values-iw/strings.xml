    <!-- help pages for problems -->
    <string name="help_button">מה אפשר לעשות?</string>
    <string name="help_what">מה קרה</string>
    <string name="help_try">מה לנסות</string>
    <string name="help_details">פרטים</string>
    <string name="help_copy">העתקת הפרטים</string>
    <string name="help_copied">הועתק</string>
    <string name="help_unreachable_title">אי אפשר להגיע לקונסולה</string>
    <string name="help_unreachable_what">אף אחד לא עונה בכתובת של הקונסולה.</string>
    <string name="help_unreachable_try">• בדקו את כתובת ה-IP ב-%1$s (Settings &gt; Network &gt; Connection Status). היא עשויה להשתנות לאחר הפעלה מחדש.\n• העירו את הקונסולה לגמרי. מצב מנוחה מכבה לעיתים קרובות את הרשת.\n• השתמשו באותה רשת Wi-Fi בשני המכשירים. רשתות אורחים ו-VPN חוסמים את החיבור.</string>
    <string name="help_port_title">השירות הזה לא פועל</string>
    <string name="help_port_what">הקונסולה ענתה, אבל שום דבר לא מאזין בפורט הזה.</string>
    <string name="help_port_try">• הפעילו את etaHEN בקונסולה. הוא מספק את Installer (12800), את Loader (9021) ואת FTP (1337).\n• payload נפרד של FTP משתמש בדרך כלל ב-2121. הזינו כאן את אותו פורט.\n• בכרטיס הקונסולה, נורה כבויה מראה מה חסר.</string>
    <string name="help_port_try_ps4">• הפעילו את GoldHEN בקונסולה. הוא מספק את Loader (9090) ואת FTP (2121).\n• כדי להתקין חבילות, הפעילו בקונסולה גם את Remote Package Installer של flatz (12800).\n• בכרטיס הקונסולה, נורה כבויה מראה מה חסר.</string>
    <string name="help_login_title">כניסת FTP נדחתה</string>
    <string name="help_login_what">שרת ה-FTP של הקונסולה דחה את שם המשתמש או את הסיסמה.</string>
    <string name="help_login_try">• %2$s מקבל את שם המשתמש anonymous עם כל סיסמה.\n• אם הגדרתם כניסה בקונסולה, הזינו אותה בלשונית העלאה.\n• הסיסמה לא נשמרת. הזינו אותה שוב לאחר הפעלה מחדש של האפליקציה.</string>
    <string name="help_dropped_title">החיבור נותק</string>
    <string name="help_dropped_what">הקשר עם הקונסולה נפסק או שהנתונים הפסיקו לזרום. האפליקציה מנסה שוב וממשיכה מהמקום שבו נעצרה.</string>
    <string name="help_dropped_try">• השאירו את הטלפון קרוב לנתב ואת הקונסולה ערה.\n• השהו הורדות גדולות אחרות ברשת.\n• אם זה ממשיך להיכשל, המתינו רגע והקישו על ניסיון חוזר.</string>
    <string name="help_refused_title">ה-Installer לא קיבל את הקישור</string>
    <string name="help_refused_what">אפשר להגיע לקונסולה, אבל ה-Installer שלה דחה את הקישור הזה.</string>
    <string name="help_refused_try">• הקישור חייב להוביל ישירות לקובץ החבילה ולהיפתח ללא כניסה.\n• הקונסולה חייבת להצליח להגיע אליו. קישורים מהטלפון הזה פועלים רק באותה רשת Wi-Fi.\n• ודאו שה-Installer פועל ושיש לקונסולה מקום פנוי.</string>
    <string name="help_storage_title">הקונסולה הפסיקה לשמור</string>
    <string name="help_storage_what">הקונסולה שמרה פחות ממה שנשלח. הכונן בדרך כלל מלא או לקריאה בלבד.</string>
    <string name="help_storage_try">• פנו מקום בקונסולה.\n• בחרו תיקייה אחרת, למשל בכונן USB.\n• לאחר מכן הקישו על ניסיון חוזר.</string>
    <string name="help_denied_title">התיקייה או הקובץ נדחו</string>
    <string name="help_denied_what">שרת ה-FTP לא יכול לפתוח אותם, לכתוב אליהם או לשנות אותם כאן.</string>
    <string name="help_denied_try">• ודאו שהתיקייה קיימת. השמות רגישים לאותיות גדולות וקטנות.\n• תיקיות מערכת הן לקריאה בלבד. השתמשו ב-/data או בכונן USB.\n• קובץ שמשחק פעיל משתמש בו עשוי להיות נעול. סגרו את המשחק.</string>
    <string name="help_phone_title">הטלפון לא יכול להשתמש בקובץ</string>
    <string name="help_phone_what">הקובץ נעלם או הועבר, האפליקציה איבדה גישה אליו, או שנגמר המקום בטלפון.</string>
    <string name="help_phone_try">• בחרו שוב את הקובץ.\n• פנו מקום אחסון בטלפון.\n• אם הקובץ נמצא באפליקציית ענן, שמרו אותו קודם בטלפון.</string>
    <string name="help_link_title">קישור ההורדה נכשל</string>
    <string name="help_link_what">האתר לא מסר את הקובץ. ייתכן שהקישור פג תוקף, דורש כניסה, או שהאתר עמוס.</string>
    <string name="help_link_try">• התחילו את ההורדה שוב מהלשונית אינטרנט. כך הכניסה שלכם נשמרת.\n• קישורים מאתרי אחסון קבצים פגים לעיתים קרובות אחרי כמה דקות.\n• אם האתר דיווח על שגיאה בסדרת 500, נסו שוב מאוחר יותר.</string>

