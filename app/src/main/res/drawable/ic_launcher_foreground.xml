<?xml version="1.0" encoding="utf-8"?>
<!-- Crimson Multitool's icon: a crimson hex nut (a tool, and hex as in hex editing) with a terminal prompt in its eye -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- the nut's lower side, for depth -->
    <path
        android:pathData="M54,26.5L79.98,41.5L79.98,71.5L54,86.5L28.02,71.5L28.02,41.5Z"
        android:fillColor="#FF5A000E" />
    <!-- the nut -->
    <path android:pathData="M54,24L79.98,39L79.98,69L54,84L28.02,69L28.02,39Z">
        <aapt:attr name="android:fillColor">
            <gradient android:startX="32" android:startY="26" android:endX="76" android:endY="82" android:type="linear">
                <item android:color="#FFFF4D5E" android:offset="0" />
                <item android:color="#FFE0182E" android:offset="0.35" />
                <item android:color="#FFB3001B" android:offset="0.7" />
                <item android:color="#FF7A0012" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- light along the top edges -->
    <path
        android:pathData="M28.6,39.3L54,24.6L79.4,39.3"
        android:strokeColor="#FFFFC2C8"
        android:strokeAlpha="0.55"
        android:strokeWidth="1"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- the eye of the nut: a dark screen -->
    <path
        android:pathData="M71.5,54C71.5,63.67 63.67,71.5 54,71.5C44.33,71.5 36.5,63.67 36.5,54C36.5,44.33 44.33,36.5 54,36.5C63.67,36.5 71.5,44.33 71.5,54Z"
        android:fillColor="#FF0B0304" />
    <!-- its rim -->
    <path
        android:pathData="M71.5,54C71.5,63.67 63.67,71.5 54,71.5C44.33,71.5 36.5,63.67 36.5,54C36.5,44.33 44.33,36.5 54,36.5C63.67,36.5 71.5,44.33 71.5,54Z"
        android:strokeColor="#FF3A0008"
        android:strokeWidth="1.6" />
    <!-- the prompt: > and a red cursor -->
    <path
        android:pathData="M45.5,48L51.5,54L45.5,60"
        android:strokeColor="#FFFFE6E8"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M54.5,60L62.5,60"
        android:strokeColor="#FFFF4D5E"
        android:strokeWidth="3.2"
        android:strokeLineCap="round" />
</vector>
