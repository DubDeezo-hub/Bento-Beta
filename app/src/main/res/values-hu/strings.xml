    <!-- help pages for problems -->
    <string name="help_button">Mit tehetek?</string>
    <string name="help_what">Mi történt</string>
    <string name="help_try">Mit érdemes kipróbálni</string>
    <string name="help_details">Részletek</string>
    <string name="help_copy">Részletek másolása</string>
    <string name="help_copied">Másolva</string>
    <string name="help_unreachable_title">A konzol nem érhető el</string>
    <string name="help_unreachable_what">A konzol címén semmi nem válaszol.</string>
    <string name="help_unreachable_try">• Ellenőrizd az IP-címet a PS5-ön (Beállítások &gt; Hálózat &gt; Kapcsolat állapota). Újraindítás után megváltozhat.\n• Ébreszd fel teljesen a konzolt. A pihenő mód gyakran kikapcsolja a hálózatot.\n• Mindkét eszközön ugyanazt a Wi-Fi-t használd. A vendéghálózatok és a VPN-ek blokkolják.</string>
    <string name="help_port_title">Az a szolgáltatás nem fut</string>
    <string name="help_port_what">A konzol válaszolt, de azon a porton semmi sem figyel.</string>
    <string name="help_port_try">• Indítsd el az etaHEN-t a konzolon. Ez biztosítja az Installert (12800), a Loadert (9021) és az FTP-t (1337).\n• Egy különálló FTP payload általában a 2121-es portot használja. Itt ugyanazt a portot add meg.\n• A konzol kártyáján a kialudt jelzőfény mutatja, mi hiányzik.</string>
    <string name="help_login_title">Az FTP-bejelentkezést elutasították</string>
    <string name="help_login_what">A konzol FTP-kiszolgálója elutasította a felhasználónevet vagy a jelszót.</string>
    <string name="help_login_try">• Az etaHEN az anonymous felhasználónevet bármilyen jelszóval elfogadja.\n• Ha beállítottál bejelentkezést a konzolon, add meg a Feltöltés alatt.\n• A jelszó nem kerül mentésre. Az alkalmazás újraindítása után add meg újra.</string>
    <string name="help_dropped_title">A kapcsolat megszakadt</string>
    <string name="help_dropped_what">A konzollal a kapcsolat megszakadt, vagy az adatforgalom leállt. Az alkalmazás újrapróbálkozik, és onnan folytatja, ahol abbahagyta.</string>
    <string name="help_dropped_try">• Tartsd a telefont a router közelében, a konzolt pedig ébren.\n• Szüneteltesd a hálózat többi nagy letöltését.\n• Ha továbbra is sikertelen, várj egy kicsit, és koppints az Újrapróbálás gombra.</string>
    <string name="help_refused_title">Az Installer nem fogadta el a linket</string>
    <string name="help_refused_what">A konzol elérhető, de az Installere elutasította ezt a linket.</string>
    <string name="help_refused_try">• A linknek közvetlenül a csomagfájlra kell mutatnia, és bejelentkezés nélkül meg kell nyílnia.\n• A konzolnak el kell tudnia érni. A telefonról származó linkek csak ugyanazon a Wi-Fi-n működnek.\n• Ellenőrizd, hogy az Installer fut-e, és van-e szabad hely a konzolon.</string>
    <string name="help_storage_title">A konzol leállt a mentéssel</string>
    <string name="help_storage_what">A konzol kevesebbet tárolt el, mint amennyit küldtek. A meghajtó általában tele van vagy csak olvasható.</string>
    <string name="help_storage_try">• Szabadíts fel helyet a konzolon.\n• Válassz másik mappát, például egy USB-meghajtón.\n• Ezután koppints az Újrapróbálás gombra.</string>
    <string name="help_denied_title">Ezt a mappát vagy fájlt elutasították</string>
    <string name="help_denied_what">Az FTP-kiszolgáló itt nem tudja megnyitni, írni vagy módosítani.</string>
    <string name="help_denied_try">• Ellenőrizd, hogy a mappa létezik-e. A nevek kis- és nagybetűérzékenyek.\n• A rendszermappák csak olvashatók. Használd a /data mappát vagy egy USB-meghajtót.\n• Egy futó játék által használt fájl zárolva lehet. Zárd be a játékot.</string>
    <string name="help_phone_title">A telefon nem tudja használni a fájlt</string>
    <string name="help_phone_what">A fájl eltűnt vagy áthelyezték, az alkalmazás elvesztette a hozzáférést, vagy elfogyott a telefon tárhelye.</string>
    <string name="help_phone_try">• Válaszd ki újra a fájlt.\n• Szabadíts fel tárhelyet a telefonon.\n• Felhőalkalmazásban lévő fájlnál előbb mentsd a telefonra.</string>
    <string name="help_link_title">A letöltési link nem működött</string>
    <string name="help_link_what">A webhely nem adta át a fájlt. A link lehet, hogy lejárt, bejelentkezést kér, vagy a webhely túlterhelt.</string>
    <string name="help_link_try">• Indítsd újra a letöltést a Web lapról. Így megmarad a bejelentkezésed.\n• A fájlmegosztó webhelyek linkjei gyakran néhány perc után lejárnak.\n• Ha a webhely 500-as tartományú hibát jelzett, próbáld újra később.</string>

