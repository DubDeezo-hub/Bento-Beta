    <string name="about_releases">Releases பக்கம்</string>
    <string name="backup_title">காப்புப்பிரதி</string>
    <string name="backup_text">உங்கள் கன்சோல்கள், முகப்புப் பக்கம், புக்மார்க்குகள், விளம்பரப் பட்டியல், payload-களை ஒரே கோப்பில் சேமிக்கிறது. FTP கடவுச்சொற்கள் சேமிக்கப்படாது.</string>
    <string name="backup_save">காப்புப்பிரதியைச் சேமி</string>
    <string name="backup_restore">காப்புப்பிரதியை மீட்டெடு</string>
    <string name="backup_saved">காப்புப்பிரதி சேமிக்கப்பட்டது.</string>
    <string name="backup_contents">கன்சோல்கள்: %1$d · புக்மார்க்குகள்: %2$d · Payload-கள்: %3$d</string>
    <string name="backup_made">%1$s அன்று உருவாக்கப்பட்டது</string>
    <string name="backup_skipped">கோப்பு மிகப் பெரிதாகிவிடும் என்பதால் விடப்பட்ட payload-கள்: %1$d</string>
    <string name="backup_bad_file">அந்தக் கோப்பு Bento காப்புப்பிரதி அல்ல.</string>
    <string name="backup_too_new">அந்தக் காப்புப்பிரதி Bento-வின் புதிய பதிப்பால் உருவாக்கப்பட்டது. செயலியைப் புதுப்பித்து, பிறகு மீண்டும் முயலவும்.</string>
    <string name="restore_title">இந்தக் காப்புப்பிரதியை மீட்டெடுக்கவா?</string>
    <string name="restore_text">உங்கள் கன்சோல்கள், முகப்புப் பக்கம், புக்மார்க்குகள், விளம்பரப் பட்டியல் ஆகியவை கோப்பில் உள்ளவற்றால் மாற்றப்படும். கோப்பில் உள்ள payload-கள் payload நூலகத்தில் சேர்க்கப்படும். உங்கள் FTP கடவுச்சொற்களை மீண்டும் தட்டச்சு செய்ய வேண்டும்.</string>
