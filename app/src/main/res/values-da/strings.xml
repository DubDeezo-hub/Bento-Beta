    <!-- help pages for problems -->
    <string name="help_button">Hvad kan jeg gøre?</string>
    <string name="help_what">Hvad skete der</string>
    <string name="help_try">Hvad du kan prøve</string>
    <string name="help_details">Detaljer</string>
    <string name="help_copy">Kopiér detaljer</string>
    <string name="help_copied">Kopieret</string>
    <string name="help_unreachable_title">Kan ikke nå konsollen</string>
    <string name="help_unreachable_what">Der svarer ikke noget på konsollens adresse.</string>
    <string name="help_unreachable_try">• Tjek IP-adressen på %1$s (Indstillinger &gt; Netværk &gt; Forbindelsesstatus). Den kan ændre sig efter en genstart.\n• Væk konsollen helt. Hviletilstand slår ofte netværket fra.\n• Brug samme Wi-Fi på begge. Gæstenetværk og VPN blokerer det.</string>
    <string name="help_port_title">Den tjeneste kører ikke</string>
    <string name="help_port_what">Konsollen svarede, men intet lytter på den port.</string>
    <string name="help_port_try">• Start etaHEN på konsollen. Den leverer Installer (12800), Loader (9021) og FTP (1337).\n• En separat FTP-payload bruger som regel 2121. Indtast samme port her.\n• På konsolkortet viser det lys, der er slukket, hvad der mangler.</string>
    <string name="help_port_try_ps4">• Start GoldHEN på konsollen. Den leverer Loader (9090) og FTP (2121).\n• For at installere pakker skal flatz\' Remote Package Installer også køre på konsollen (12800).\n• På konsolkortet viser det lys, der er slukket, hvad der mangler.</string>
    <string name="help_login_title">FTP-login afvist</string>
    <string name="help_login_what">Konsollens FTP-server afviste brugernavnet eller adgangskoden.</string>
    <string name="help_login_try">• %2$s accepterer brugernavnet anonymous med en vilkårlig adgangskode.\n• Hvis du har oprettet et login på konsollen, skal du indtaste det under Upload.\n• Adgangskoden gemmes ikke. Indtast den igen, når du har genstartet appen.</string>
    <string name="help_dropped_title">Forbindelsen blev afbrudt</string>
    <string name="help_dropped_what">Forbindelsen til konsollen blev afbrudt, eller der flyttes ikke længere data. Appen prøver igen og fortsætter, hvor den slap.</string>
    <string name="help_dropped_try">• Hold telefonen tæt på routeren, og hold konsollen vågen.\n• Sæt andre store downloads på netværket på pause.\n• Hvis det bliver ved med at fejle, så vent lidt, og tryk på Prøv igen.</string>
    <string name="help_refused_title">Installer tog ikke imod linket</string>
    <string name="help_refused_what">Konsollen kan nås, men dens Installer afviste dette link.</string>
    <string name="help_refused_try">• Linket skal føre direkte til pakkefilen og kunne åbnes uden login.\n• Konsollen skal kunne nå det. Links fra denne telefon virker kun på samme Wi-Fi.\n• Tjek, at Installer kører, og at konsollen har ledig plads.</string>
    <string name="help_storage_title">Konsollen holdt op med at gemme</string>
    <string name="help_storage_what">Konsollen gemte mindre, end der blev sendt. Drevet er som regel fuldt eller skrivebeskyttet.</string>
    <string name="help_storage_try">• Frigør plads på konsollen.\n• Vælg en anden mappe, for eksempel på et USB-drev.\n• Tryk derefter på Prøv igen.</string>
    <string name="help_denied_title">Mappen eller filen blev afvist</string>
    <string name="help_denied_what">FTP-serveren kan ikke åbne, skrive til eller ændre den her.</string>
    <string name="help_denied_try">• Tjek, at mappen findes. Der skelnes mellem store og små bogstaver i navne.\n• Systemmapper er skrivebeskyttede. Brug /data eller et USB-drev.\n• En fil, der bruges af et spil, som kører, kan være låst. Luk spillet.</string>
    <string name="help_phone_title">Telefonen kan ikke bruge filen</string>
    <string name="help_phone_what">Filen er væk eller flyttet, appen har mistet adgangen til den, eller telefonen har ikke mere plads.</string>
    <string name="help_phone_try">• Vælg filen igen.\n• Frigør lagerplads på telefonen.\n• Hvis filen ligger i en skyapp, så gem den på telefonen først.</string>
    <string name="help_link_title">Download-linket fejlede</string>
    <string name="help_link_what">Hjemmesiden afleverede ikke filen. Linket kan være udløbet, kræve login, eller siden er optaget.</string>
    <string name="help_link_try">• Start downloaden igen fra Web-fanen. Så beholder du dit login.\n• Links fra fildelingssider udløber ofte efter få minutter.\n• Hvis siden meldte en fejl i 500-serien, så prøv igen senere.</string>

