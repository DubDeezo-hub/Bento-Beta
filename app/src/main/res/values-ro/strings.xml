    <string name="help_button">Ce pot face?</string>
    <string name="help_what">Ce s-a întâmplat</string>
    <string name="help_try">Ce poți încerca</string>
    <string name="help_details">Detalii</string>
    <string name="help_copy">Copiază detaliile</string>
